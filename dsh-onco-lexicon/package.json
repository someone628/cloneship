{
  "name": "dsh-onco-lexicon",
  "version": "0.7.0",
  "description": "DSH 肿瘤学术语词典插件：术语、缩写、生物标志物、抗肿瘤药物与临床试验终点查询，支持中英术语对照与长文本术语标注，含可浏览的侧边栏栏目。本地优先，本地未收录时联网查 NCI EVS（NCIt）与 NLM MeSH 兜底。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "oncology",
    "lexicon",
    "offline-first",
    "ncit",
    "mesh"
  ],
  "type": "module",
  "license": "MIT",
  "author": "evilfies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/someone628/cloneship.git",
    "directory": "dsh-onco-lexicon"
  },
  "homepage": "https://github.com/someone628/cloneship/tree/main/dsh-onco-lexicon#readme",
  "bugs": {
    "url": "https://github.com/someone628/cloneship/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/icon.png",
    "data/onco.ncit.jsonl",
    "data/onco.seed.jsonl",
    "cordis.patch.yml",
    "skill.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
