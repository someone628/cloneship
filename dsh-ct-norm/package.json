{
  "name": "dsh-ct-norm",
  "version": "0.1.0",
  "description": "DSH CT 报告实体归一化插件：从中文 CT 影像报告原始文本中抽取自由描述，确定性归一化到 MeSH 2026 标准概念（规范名 / MeSH 编号 / 树号一律取自 NLM 索引，中文别名层自建）。未收录的写法如实报出，不做模型推断。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ct-report",
    "radiology",
    "entity-normalization",
    "mesh",
    "offline-first"
  ],
  "type": "module",
  "license": "MIT",
  "author": "someone628",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/someone628/cloneship.git",
    "directory": "dsh-ct-norm"
  },
  "homepage": "https://github.com/someone628/cloneship/tree/main/dsh-ct-norm#readme",
  "bugs": {
    "url": "https://github.com/someone628/cloneship/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/icon.png",
    "build-ct-lexicon.mjs",
    "data/ct.lexicon.jsonl",
    "data/ct.rules.json",
    "data/mesh.subset.jsonl",
    "data/ct.manifest.json",
    "data/src",
    "cordis.patch.yml",
    "skill.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
